+import importlib.util
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+
+import numpy as np
+import torch
+
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+
+
+def _install_libriichi_stub():
+    consts = types.SimpleNamespace(
+        ACTION_SPACE=46,
+        GRP_SIZE=7,
+        MAX_VERSION=4,
+        obs_shape=lambda version: {
+            1: (938, 34),
+            2: (942, 34),
+            3: (934, 34),
+            4: (1012, 34),
+        }[version],
+        oracle_obs_shape=lambda version: {
+            1: (211, 34),
+            2: (217, 34),
+            3: (217, 34),
+            4: (217, 34),
+        }[version],
+    )
+    module = types.ModuleType("libriichi")
+    module.consts = consts
+    sys.modules["libriichi"] = module
+
+
+def _load_local_modules():
+    _install_libriichi_stub()
+    bot_package = types.ModuleType("bot")
+    bot_package.__path__ = [str(PROJECT_ROOT / "bot")]
+    local_package = types.ModuleType("bot.local")
+    local_package.__path__ = [str(PROJECT_ROOT / "bot" / "local")]
+    sys.modules["bot"] = bot_package
+    sys.modules["bot.local"] = local_package
+
+    model_spec = importlib.util.spec_from_file_location(
+        "bot.local.model",
+        PROJECT_ROOT / "bot" / "local" / "model.py",
+    )
+    model = importlib.util.module_from_spec(model_spec)
+    sys.modules[model_spec.name] = model
+    model_spec.loader.exec_module(model)
+
+    engine_spec = importlib.util.spec_from_file_location(
+        "bot.local.engine",
+        PROJECT_ROOT / "bot" / "local" / "engine.py",
+    )
+    engine = importlib.util.module_from_spec(engine_spec)
+    sys.modules[engine_spec.name] = engine
+    engine_spec.loader.exec_module(engine)
+    return model, engine
+
+
+MODEL, ENGINE = _load_local_modules()
+
+
+class LocalEngineCheckpointTests(unittest.TestCase):
+    def _save_checkpoint(self, payload):
+        temp_dir = tempfile.TemporaryDirectory()
+        self.addCleanup(temp_dir.cleanup)
+        checkpoint = Path(temp_dir.name) / "model.pth"
+        torch.save(payload, checkpoint)
+        return checkpoint
+
+    @staticmethod
+    def _config():
+        return {
+            "control": {"version": 4},
+            "resnet": {"conv_channels": 32, "num_blocks": 1},
+        }
+
+    @staticmethod
+    def _smoke(engine):
+        obs = np.zeros((1, 1012, 34), dtype=np.float32)
+        masks = np.zeros((1, 46), dtype=np.bool_)
+        masks[0, [0, 4, 45]] = True
+        actions, scores, masks_out, is_greedy = engine.react_batch(obs, masks, None)
+        return actions, np.asarray(scores), masks_out, is_greedy
+
+    def test_loads_current_supervised_checkpoint(self):
+        brain = MODEL.Brain(
+            version=4,
+            conv_channels=32,
+            num_blocks=1,
+            Norm="GN",
+        )
+        policy = MODEL.CategoricalPolicy()
+        checkpoint = self._save_checkpoint({
+            "mortal": brain.state_dict(),
+            "policy_net": policy.state_dict(),
+            "steps": 390000,
+            "checkpoint_label": "s70-test",
+            "config": self._config(),
+        })
+
+        loaded = ENGINE.get_engine(checkpoint, device="cpu")
+        actions, scores, _, is_greedy = self._smoke(loaded)
+
+        self.assertEqual("policy_net/categorical/GN", loaded.checkpoint_format)
+        self.assertEqual(390000, loaded.checkpoint_steps)
+        self.assertEqual([True], is_greedy)
+        self.assertIn(actions[0], (0, 4, 45))
+        self.assertAlmostEqual(1.0, float(scores.sum()), places=5)
+        self.assertTrue(any(isinstance(mod, torch.nn.GroupNorm) for mod in loaded.brain.modules()))
+
+    def test_loads_current_rl_oracle_structure_with_zero_hidden_input(self):
+        brain = MODEL.Brain(
+            version=4,
+            conv_channels=32,
+            num_blocks=1,
+            is_oracle=True,
+            Norm="GN",
+        )
+        policy = MODEL.CategoricalPolicy()
